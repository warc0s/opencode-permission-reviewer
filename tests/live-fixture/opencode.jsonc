{
  "$schema": "https://opencode.ai/config.json",
  // NOTE: the absolute plugin paths below must point at your local checkout
  // of opencode-permission-reviewer before running the live harness.
  "plugin": [
    "/absolute/path/to/opencode-permission-reviewer/tests/live-driver-plugin.ts",
    [
      "/absolute/path/to/opencode-permission-reviewer",
      {
        "model": "openai/gpt-6-luna",
        "variant": "medium",
        "timeoutMs": 180000,
        "confidenceThreshold": 0.7,
        "retainReviewSessions": false,
        "debug": true
      }
    ]
  ],
  "permission": {
    "bash": "ask"
  }
}
