{
  "name": "permission-reviewer-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Permission reviewer evaluation with real plugin prompts and gates, inert fixtures and auditable logs",
  "scripts": {
    "bench": "bun cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node cli.mjs validate",
    "smoke": "node cli.mjs baseline --out runs/smoke",
    "test:plugin": "bun tests/plugin-parity.mjs --repo ../.."
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  }
}
